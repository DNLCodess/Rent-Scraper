# Copy to .env.local and fill in. Never commit real values.

# Apify API token (Apify Console -> Settings -> API & Integrations).
# Can also be set from the in-app Settings page, which overrides this.
APIFY_TOKEN=

# Optional: Apify actor to use (default: clockworks~tiktok-scraper).
# APIFY_ACTOR=clockworks~tiktok-scraper

# "mock" returns sample data without calling Apify (free, for development/demos).
# Leave unset to use Apify.
# SCRAPER_PROVIDER=mock

# Database. Local default is a SQLite file. On Vercel, use a Turso database:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso token>
DATABASE_URL=file:data/app.db
# DATABASE_AUTH_TOKEN=

# Optional: protect the whole app with HTTP Basic auth (any username, this password).
# Strongly recommended for public deployments, so strangers can't spend your Apify credit.
# APP_PASSWORD=
